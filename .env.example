# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env            (or run .\scripts\setup.ps1, which does all of this)
#
# Then generate the HTTPS development certificate:
#
#   dotnet dev-certs https -ep "$env:USERPROFILE\.aspnet\https\TicketMiser.Web.pfx" -p <CERT_PASSWORD>
#   dotnet dev-certs https --trust

POSTGRES_PASSWORD=

# Must exactly match the -p value used when exporting the PFX above.
CERT_PASSWORD=

# Host directory containing TicketMiser.Web.pfx. Mounted read-only into the container.
CERT_PATH=${USERPROFILE}/.aspnet/https

# Host port for the app (HTTPS). Published on 127.0.0.1 only.
HTTPS_PORT=8443

# Source keys. Blank leaves a source unregistered: not an outage, just unconfigured.
# Ticketmaster: free key from developer.ticketmaster.com; 5,000 calls/day, 5/s.
TICKETMASTER_ENABLED=false
TICKETMASTER_KEY=
# Inventory Status API is a separate key on the same portal.
TICKETMASTER_INVENTORY_ENABLED=false
TICKETMASTER_INVENTORY_KEY=
# The Discovery Feed uses TICKETMASTER_KEY.
DISCOVERY_FEED_ENABLED=false
# SeatGeek: free client id from seatgeek.com/account/develop.
SEATGEEK_ENABLED=false
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# Email: subscription confirmations and the primary_reappeared alert.
# pickup (the default) sends nothing: each message is written as an .eml file under
# /tmp/outbox in the container, or data/outbox under the content root for a host run.
# postmark sends through Postmark's API, and only when POSTMARK_SERVER_TOKEN is also set.
NOTIFICATIONS_PROVIDER=pickup
# Server API token from the Postmark server's API Tokens tab. Blank keeps the pickup directory.
POSTMARK_SERVER_TOKEN=
# The From header. With Postmark it must be a confirmed sender signature or domain.
NOTIFICATIONS_FROM="TicketMiser <alerts@ticketmiser.invalid>"
# The public origin every link in an email is built from: confirm, unsubscribe, the record.
NOTIFICATIONS_PUBLIC_BASE_URL=https://localhost:8443

# Affiliate deep links (Impact) on price cells. Disabled, or any id the template names left
# blank, and every price cell links the plain event page. The ids come from the Impact
# dashboard once each programme accepts the account; none belong in this file.
# The template's {url} receives the event page, percent-encoded once. Impact's format is
#   https://<tracking domain>/c/<partner id>/<ad id>/<campaign id>?u=<encoded destination>
# and Impact's "campaign id" is the brand's programme, so it is PROGRAM_ID here.
# Rule 6: the Ticketmaster programme is the only Ticketmaster revenue path (docs/legal-guidelines.md).
TICKETMASTER_AFFILIATE_ENABLED=false
TICKETMASTER_AFFILIATE_TEMPLATE=https://ticketmaster.evyy.net/c/{publisherId}/{adId}/{programId}?u={url}
TICKETMASTER_AFFILIATE_PUBLISHER_ID=
TICKETMASTER_AFFILIATE_AD_ID=
TICKETMASTER_AFFILIATE_PROGRAM_ID=
SEATGEEK_AFFILIATE_ENABLED=false
SEATGEEK_AFFILIATE_TEMPLATE=https://seatgeek.pxf.io/c/{publisherId}/{adId}/{programId}?u={url}
SEATGEEK_AFFILIATE_PUBLISHER_ID=
SEATGEEK_AFFILIATE_AD_ID=
SEATGEEK_AFFILIATE_PROGRAM_ID=
