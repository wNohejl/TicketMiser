{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "TicketMiser": "Host=localhost;Port=5434;Database=ticketmiser;Username=ticketmiser"
  },
  "Ingestion": {
    "//1": "Kept in step with src/TicketMiser.Web/appsettings.json; both hosts run the same scheduler.",
    "Market": {
      "City": "Nashville",
      "StateCode": "TN",
      "CountryCode": "US",
      "CategoryKey": "concert",
      "DiscoveryHorizon": "120.00:00:00"
    },
    "RunOnStartup": false,
    "PricePolling": {
      "Mode": "Manual",
      "ReservePercent": 20,
      "MinimumInterval": "00:05:00",
      "MaximumInterval": "03:00:00"
    },
    "OnSaleWatch": {
      "Enabled": true,
      "Lead": "00:15:00",
      "Tail": "02:00:00",
      "Tick": "00:05:00",
      "HourlyTail": "1.00:00:00"
    },
    "Retention": {
      "Enabled": true,
      "FinaliseAfterStart": "00:10:00",
      "Interval": "00:15:00"
    },
    "//2": "Keys are supplied out of band: user-secrets for host runs, .env for compose. Never in this file.",
    "Ticketmaster": { "Enabled": false, "ApiKey": "" },
    "TicketmasterInventory": { "Enabled": false, "ApiKey": "" },
    "DiscoveryFeed": { "Enabled": false, "MaxBytes": 419430400, "Interval": "1.00:00:00" },
    "SeatGeek": { "Enabled": false, "ClientId": "", "ClientSecret": "" }
  },
  "Reliability": {
    "FreshnessSlo": "26:00:00",
    "SuccessRateSlo": 0.95,
    "SuccessRateWindow": "7.00:00:00",
    "VolumeAnomalyThreshold": 0.5,
    "VolumeBaselineDays": 7,
    "BudgetWarnThreshold": 0.8,
    "EvaluationInterval": "00:05:00",
    "AutoIncidentAfterCriticals": 2
  },
  "Observability": {
    "Enabled": false,
    "ServiceName": "ticketmiser-worker",
    "OtlpEndpoint": "http://localhost:18889",
    "MetricsSampleInterval": "00:00:30"
  }
}
