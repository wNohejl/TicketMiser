<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    The standalone ingestion host. Optional in a personal deployment, where the web app hosts
    the same scheduler in-process, but it exists so ingestion can run as its own process.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-TicketMiser.Worker-7d1f0c2e-6b0a-4c1b-9a6e-0f4c2b9e1a11</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TicketMiser.Core\TicketMiser.Core.csproj" />
    <ProjectReference Include="..\TicketMiser.Data\TicketMiser.Data.csproj" />
    <ProjectReference Include="..\TicketMiser.Reliability\TicketMiser.Reliability.csproj" />
    <ProjectReference Include="..\TicketMiser.Ingestion\TicketMiser.Ingestion.csproj" />
    <ProjectReference Include="..\TicketMiser.Observability\TicketMiser.Observability.csproj" />
  </ItemGroup>
</Project>
