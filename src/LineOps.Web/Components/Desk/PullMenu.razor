@namespace LineOps.Desk.Primitives
@using LineOps.Ingestion.Services
@using LineOps.Desk.Windowing
@inject IngestionJobs Jobs
@inject DeskToasts Toasts

@*
    The desk's one manual control over ingestion.

    It replaces a button called "Ingest now", which ran every odds source across every sport
    and nothing else — so the operator could not fetch today's games or last night's results
    with it, and had no idea what pressing it would spend. A menu of named pulls says what each
    one does and what it costs before it is chosen.

    Every entry runs the same job the scheduler runs. Nothing here is a second implementation.
*@

<div class="pullmenu">
    <DeskButton Emphasis="DeskEmphasis.Filled"
                Icon="@Icons.Material.Filled.CloudDownload"
                Busy="@(_running is not null)"
                OnClick="Toggle">
        @(_running is null ? "Pull data" : _runningLabel)
    </DeskButton>

    @if (_open)
    {
        <div class="pullmenu__backdrop" @onclick="Close"></div>

        <div class="pullmenu__panel">
            @foreach (var job in _jobs)
            {
                <button type="button"
                        class="pullmenu__item @(job.Available ? null : "pullmenu__item--blocked")"
                        disabled="@(!job.Available || _running is not null)"
                        @onclick="() => RunJobAsync(job)">
                    <span class="pullmenu__row">
                        <span class="pullmenu__label">@job.Label</span>
                        @* Credits where the provider bills in them, because that is the number
                           that runs out — a call costing one request can cost several credits. *@
                        <span class="pullmenu__cost">
                            @(job.EstimatedCredits > 0
                                ? $"{job.EstimatedCredits} credits"
                                : job.EstimatedRequests == 0 ? "no requests" : $"~{job.EstimatedRequests} req")
                        </span>
                    </span>
                    <span class="pullmenu__desc">
                        @(job.Available ? job.Description : job.Unavailable)
                    </span>
                </button>
            }
        </div>
    }
</div>

@* A pull's outcome is a toast, not a Note. A Note is the ambient tier — it sits beside the
   thing it describes and stays as long as that thing is true. "14 rows arrived" stops being
   true the moment it is read, and the rows themselves are the durable record. Left as a Note
   it never cleared, and a bordered box parked in the toolbar beside the Pull key read as a
   second control that could not be pressed. *@

@code {
    /// <summary>Raised after a pull so the hosting panel can reload what it shows.</summary>
    [Parameter] public EventCallback OnPulled { get; set; }

    /// <summary>Lets the panel drive its own pulse from the pull.</summary>
    [Parameter] public EventCallback<bool> OnBusyChanged { get; set; }


    private IReadOnlyList<IngestionJob> _jobs = [];
    private bool _open;
    private string? _running;
    private string _runningLabel = "Pulling";

    protected override async Task OnInitializedAsync()
        => _jobs = await Jobs.DescribeAsync();

    private async Task Toggle()
    {
        _open = !_open;

        // Costs move with the season — a sport coming in changes every estimate — so the menu
        // re-reads them on open rather than trusting what it loaded once.
        if (_open)
            _jobs = await Jobs.DescribeAsync();
    }

    private void Close() => _open = false;

    /// <summary>
    /// Runs one named pull as if it had been chosen from the menu.
    ///
    /// <para>
    /// This is how an empty state or an unpriced row can offer the fix where the problem is
    /// stated, instead of describing a control somewhere else on the screen. It presses this
    /// menu rather than reimplementing it, so the busy key, the toast and the reload all
    /// behave exactly as they do when the entry is chosen by hand.
    /// </para>
    ///
    /// <para>
    /// A job that is unavailable — no source registered, no key — opens the menu instead of
    /// failing silently, because the menu is where the reason is written.
    /// </para>
    /// </summary>
    public async Task RunAsync(string key)
    {
        if (_running is not null)
            return;

        // The estimates move with the season, and this can be pressed long after the menu was
        // last opened, so the catalog is re-read rather than trusted.
        _jobs = await Jobs.DescribeAsync();

        var job = _jobs.FirstOrDefault(j => j.Key == key);

        if (job is null || !job.Available)
        {
            _open = true;
            StateHasChanged();
            return;
        }

        await RunJobAsync(job);
        StateHasChanged();
    }

    private async Task RunJobAsync(IngestionJob job)
    {
        _open = false;
        _running = job.Key;
        _runningLabel = job.Label;

        await OnBusyChanged.InvokeAsync(true);

        try
        {
            var outcome = await Jobs.RunAsync(job.Key);

            var summary = outcome.Detail
                ?? (outcome.Succeeded
                    ? $"{job.Label}: {outcome.Rows:N0} rows."
                    : $"{job.Label}: {outcome.Failures} source failed.");

            // Succeeding with nothing is worth saying differently. A pull that returns zero
            // rows is not a failure — the scan may simply not have covered a fixture — but
            // reporting it as a success reads as "done" when nothing arrived.
            if (!outcome.Succeeded)
                Toasts.Warn(summary);
            else if (outcome.Rows == 0)
                Toasts.Info($"{job.Label}: nothing new to store.");
            else
                Toasts.Success(summary);

            await OnPulled.InvokeAsync();
        }
        catch (Exception ex)
        {
            Toasts.Fail($"{job.Label} failed: {ex.Message}");
        }
        finally
        {
            _running = null;
            await OnBusyChanged.InvokeAsync(false);
        }
    }
}
