@using TicketMiser.Desk.Windowing
@using TicketMiser.Desk.Theming
@inherits DeskPanel
@implements IDisposable
@inject ThemeService Theme

@*
    Desk configuration. Every control here changes the desk immediately — there is no Save,
    because the desk behind this window *is* the preview.

    Appearance leads, because it is what most operators open this window for and because
    it is the only section that changes the window itself: the gate under the pointer
    repaints as the accent lands, the words grow as the size moves. Then the window
    ceiling, then the primary window, then resolution — in the order they are reached for.
*@

<MetricRow Style="margin-bottom:16px">
    <Metric Label="Windows open" Note="ceiling you set" State="DeskState.Info">
        @Manager.OpenCount/@S.MaxConcurrentWindows
    </Metric>
    <Metric Label="Desk" Note='@(S.ResolutionMode == ResolutionMode.Fixed ? "declared" : "measured")'>
        @((int)Manager.DeskWidth)×@((int)Manager.DeskHeight)
    </Metric>
    <Metric Label="Fits readably"
            Value="@Manager.RecommendedCapacity.ToString()"
            Note="at this size and layout"
            State="@(S.MaxConcurrentWindows > Manager.RecommendedCapacity ? DeskState.Warning : DeskState.Positive)" />
</MetricRow>

@if (S.MaxConcurrentWindows > Manager.RecommendedCapacity)
{
    <Note State="DeskState.Warning" Style="margin:12px 0 16px">
        Your ceiling is above what this desk fits at a readable width. Columns hold at
        @DeskSettings.MinColumnWidth px and the row scrolls rather than squeezing further.
    </Note>
}

<PanelHeader>Appearance</PanelHeader>

<div class="stack" style="gap:10px">
    <div class="setting">
        <span class="setting__label">Theme</span>
        <DeskSwitch Options="_themes" Label="Theme"
                    Value="Theme.Mode"
                    ValueChanged="@((DeskThemeMode mode) => Theme.SetModeAsync(mode))" />
        @* Naming the resolved theme is the point of the sentence. "System" alone does not tell
           an operator which desk they are about to get, and it is the one position where the
           answer is not written on the control. *@
        <span class="setting__hint">
            @(Theme.Mode == DeskThemeMode.System
                ? $"following your machine — {(Theme.IsDark ? "dark" : "light")} right now"
                : Theme.IsDark ? "dark, whatever your machine says" : "light, whatever your machine says")
        </span>
    </div>

    <div class="setting">
        <span class="setting__label">Accent</span>
        <DeskAccentPicker Value="Theme.Accent" IsDark="Theme.IsDark"
                          ValueChanged="@((DeskAccent accent) => Theme.SetAccentAsync(accent))" />
        <span class="setting__hint">@DeskAccents.Label(Theme.Accent)</span>
    </div>

    <div class="setting">
        <span class="setting__label">Text size</span>
        <DeskSwitch Options="_textSizes" Label="Text size"
                    Value="Theme.TextSize"
                    ValueChanged="@((DeskTextSize size) => Theme.SetTextSizeAsync(size))" />
        <span class="setting__hint num">body @DeskTextSizes.BodyPx(Theme.TextSize) px</span>
    </div>

    <div class="setting">
        <span class="setting__label">Scale</span>
        <DeskSwitch Options="_scales" Label="Interface scale" Mono="true"
                    Value="Theme.UiScale"
                    ValueChanged="@((int percent) => Theme.SetUiScaleAsync(percent))" />
    </div>
</div>

<p class="empty" style="padding-top:8px">
    Kept in this browser. Text size grows the words and leaves the desk where it is; scale
    draws the whole desk larger or smaller, spacing included, so a big screen can hold
    more windows at once.
    @if (!IsDefaultAppearance)
    {
        <DeskButton style="height:22px" OnClick="@(_ => Theme.ResetAppearanceAsync())">
            Back to the defaults
        </DeskButton>
    }
</p>

<PanelHeader>Concurrent windows</PanelHeader>
<div class="row">
    <DeskButton Title="One fewer window" aria-label="One fewer window"
                OnClick="() => AdjustMax(-1)" Disabled="@(S.MaxConcurrentWindows <= 1)">
        <Glyph Icon="@Icons.Material.Filled.Remove" />
    </DeskButton>
    <span class="num" style="min-width:2.5ch; text-align:center; font-size: var(--text-title2)">@S.MaxConcurrentWindows</span>
    <DeskButton Title="One more window" aria-label="One more window"
                OnClick="() => AdjustMax(1)" Disabled="@(S.MaxConcurrentWindows >= 12)">
        <Glyph Icon="@Icons.Material.Filled.Add" />
    </DeskButton>
    <DeskButton OnClick="MatchRecommended">
        Match this desk (@Manager.RecommendedCapacity)
    </DeskButton>
</div>
<p class="empty" style="padding-top:6px">
    Windows tile as one horizontal row — every window is its own tab. Opening past this
    closes the least recently used window, named in the footer when it happens and in the
    launcher before it does. Drag a title bar past a neighbour to reorder, or the divider
    between two to resize.
</p>

<PanelHeader>Primary window</PanelHeader>
<div class="row">
    <DeskSelect TValue="string" style="min-width:200px"
                Value="@(S.PrimaryWindowKey ?? "")"
                ValueChanged="OnPrimaryChanged">
        <option value="">None — every window equal</option>
        @* A destination cannot be opened on its own, so it cannot be the window that opens
           on an empty desk either. *@
        @foreach (var definition in WindowCatalog.All.Where(d => !d.RequiresSubject))
        {
            <option value="@definition.Key">@definition.Title</option>
        }
    </DeskSelect>
</div>

@if (S.PrimaryWindowKey is not null)
{
    <div class="setting" style="margin-top:10px">
        <span class="setting__label">Share</span>
        <input type="range" min="20" max="80" step="5"
               aria-label="Primary window share"
               value="@((int)(S.PrimaryShare * 100))"
               @oninput="OnShareChanged"
               style="flex:1; max-width:240px; accent-color: var(--accent)" />
        <span class="num" style="min-width:4ch">@((int)(S.PrimaryShare * 100))%</span>
    </div>
    <p class="empty" style="padding-top:6px">
        The primary window takes this share of the row wherever it sits — it does not force
        its position, so dragging it to reorder the row is never fought. It is also what
        opens on an empty desk. Dragging a divider overrides the share until you
        <DeskButton style="height:22px" OnClick="@(_ => Manager.ResetWidths())">
            reset widths
        </DeskButton>.
    </p>
}

<PanelHeader>Resolution</PanelHeader>
<div class="row">
    <DeskSwitch Options="_modes" Label="Resolution mode"
                Value="S.ResolutionMode" ValueChanged="@((ResolutionMode mode) => SetMode(mode))" />
</div>

@if (S.ResolutionMode == ResolutionMode.Fixed)
{
    <div class="row" style="margin-top:10px">
        @* A custom size typed below matches no preset, and then the gate's cap simply
           is not there — no position pretends to be the one you are on. *@
        <DeskSwitch Options="_presets" Label="Preset size" Mono="true"
                    Value="(S.CustomWidth, S.CustomHeight)"
                    ValueChanged="@(((int W, int H) size) => ApplyPreset(size.W, size.H))" />
    </div>

    <div class="setting" style="margin-top:10px">
        <span class="setting__label">Custom</span>
        @* int? rather than int so that clearing the box is "no number yet" rather than a
           zero the clamp would turn into 640. *@
        <DeskField TValue="int?" Mono="true" type="number" min="640" max="7680" step="10"
                   style="max-width:100px"
                   Value="S.CustomWidth" ValueChanged="OnWidthChanged" />
        <span class="dim">×</span>
        <DeskField TValue="int?" Mono="true" type="number" min="480" max="4320" step="10"
                   style="max-width:100px"
                   Value="S.CustomHeight" ValueChanged="OnHeightChanged" />
    </div>

    <Note Style="margin:10px 0 12px">
        The desk lays out against @((int)Manager.DeskWidth)×@((int)Manager.DeskHeight) while your browser is
        @((int)Manager.ViewportWidth)×@((int)Manager.ViewportHeight). Use this to arrange a desk for the screen
        you will run it on, not the one you are configuring it from — the view scrolls if the
        declared size is larger.
    </Note>
}

@code {
    private DeskSettings S => Manager.Settings;

    // Dark first, because it is the desk the product is: the gate reads left-to-right as
    // "what it was, the alternative, let the machine decide".
    private static readonly IReadOnlyList<DeskSwitchOption<DeskThemeMode>> _themes =
    [
        new(DeskThemeMode.Dark, "Dark"),
        new(DeskThemeMode.Light, "Light"),
        new(DeskThemeMode.System, "System")
    ];

    private static readonly IReadOnlyList<DeskSwitchOption<DeskTextSize>> _textSizes =
        DeskTextSizes.All
            .Select(size => new DeskSwitchOption<DeskTextSize>(size, DeskTextSizes.Label(size), $"Body text at {DeskTextSizes.BodyPx(size)}px"))
            .ToList();

    private static readonly IReadOnlyList<DeskSwitchOption<int>> _scales =
        DeskUiScale.Steps
            .Select(percent => new DeskSwitchOption<int>(percent, $"{percent}%", $"Draw the whole desk at {percent}%"))
            .ToList();

    private static readonly IReadOnlyList<DeskSwitchOption<ResolutionMode>> _modes =
    [
        new(ResolutionMode.Auto, "Follow browser"),
        new(ResolutionMode.Fixed, "Declare a size")
    ];

    private static readonly IReadOnlyList<DeskSwitchOption<(int W, int H)>> _presets =
    [
        new((1280, 720), "1280×720"),
        new((1920, 1080), "1920×1080"),
        new((2560, 1440), "2560×1440"),
        new((3440, 1440), "3440×1440")
    ];

    private bool IsDefaultAppearance =>
        Theme.Mode == DeskThemeMode.System
        && Theme.Accent == DeskAccent.Blue
        && Theme.TextSize == DeskTextSize.Default
        && Theme.UiScale == DeskUiScale.Default;

    protected override void OnInitialized()
    {
        Report(PulseState.Idle, $"{Manager.OpenCount}/{S.MaxConcurrentWindows}");

        // The machine's own preference can move while this panel is open, and under
        // System that changes both the gate's position and the sentence beneath it.
        // Neither is a parameter, so nothing else would ask this panel to look again.
        Theme.Changed += OnThemeChanged;
    }

    private Task OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeChanged;

    private void AdjustMax(int delta) => Manager.UpdateSettings(s =>
        s.MaxConcurrentWindows = Math.Clamp(s.MaxConcurrentWindows + delta, 1, 12));

    private void MatchRecommended()
    {
        var target = Manager.RecommendedCapacity;
        Manager.UpdateSettings(s => s.MaxConcurrentWindows = target);
    }

    private void OnPrimaryChanged(string key)
        => Manager.UpdateSettings(s => s.PrimaryWindowKey = string.IsNullOrEmpty(key) ? null : key);

    private void OnShareChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var percent))
            Manager.UpdateSettings(s => s.PrimaryShare = percent / 100d);
    }

    private void SetMode(ResolutionMode mode)
        => Manager.UpdateSettings(s => s.ResolutionMode = mode);

    private void ApplyPreset(int width, int height) => Manager.UpdateSettings(s =>
    {
        s.CustomWidth = width;
        s.CustomHeight = height;
    });

    private void OnWidthChanged(int? value)
    {
        if (value is { } width)
            Manager.UpdateSettings(s => s.CustomWidth = Math.Clamp(width, 640, 7680));
    }

    private void OnHeightChanged(int? value)
    {
        if (value is { } height)
            Manager.UpdateSettings(s => s.CustomHeight = Math.Clamp(height, 480, 4320));
    }
}
