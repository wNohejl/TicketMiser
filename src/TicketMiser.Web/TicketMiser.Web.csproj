<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TicketMiser.Desk\TicketMiser.Desk.csproj" />
    <ProjectReference Include="..\TicketMiser.Core\TicketMiser.Core.csproj" />
    <ProjectReference Include="..\TicketMiser.Data\TicketMiser.Data.csproj" />
    <ProjectReference Include="..\TicketMiser.Reliability\TicketMiser.Reliability.csproj" />
    <ProjectReference Include="..\TicketMiser.Observability\TicketMiser.Observability.csproj" />
    <ProjectReference Include="..\TicketMiser.Ingestion\TicketMiser.Ingestion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <!-- The published monthly reports travel with the host, which serves them at /reports.
       Copied beside the assembly (reports/) on build and publish; the Dockerfile copies
       docs/reports into the build context so the container has them too. -->
  <ItemGroup>
    <Content Include="..\..\docs\reports\*.md" Link="reports\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>dotnet-TicketMiser.Web-2b7e4c9a-1d3f-4e8b-9c0a-5f6d7e8a9b0c</UserSecretsId>
  </PropertyGroup>

</Project>
