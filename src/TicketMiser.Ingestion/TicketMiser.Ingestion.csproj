<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A library, deliberately. The worker host lives in TicketMiser.Worker so that the web app
    can consume the ingestion pipeline without also inheriting an executable's entry point and
    appsettings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TicketMiser.Core\TicketMiser.Core.csproj" />
    <ProjectReference Include="..\TicketMiser.Data\TicketMiser.Data.csproj" />
    <ProjectReference Include="..\TicketMiser.Reliability\TicketMiser.Reliability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TicketMiser.Tests" />
  </ItemGroup>
</Project>
