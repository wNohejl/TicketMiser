@using LineOps.Desk.Windowing
@inject DeskBrand Brand

@*
    A small popover the rail owns outright.

    Deliberately not MudMenu: this is the primary way windows get created, so it should not
    inherit another library's positioning and z-index rules — especially when it has to open
    away from a rail that can be on any of four edges. It also gives us Escape-to-close and
    a real backdrop without fighting anyone.
*@

<div class="railmenu @Class">
    @* Two triggers, one menu. The brand is a trigger rather than a decoration because the
       thing it opens changes the whole desk, and the identity is the only element on the
       header that is about the desk as a whole. *@
    <button class="@(Trigger == "brand" ? "hdr__brand hdr__brand--menu" : $"rail__btn {(Accent ? "rail__btn--accent" : null)}")"
            type="button"
            title="@Label"
            aria-label="@Label"
            aria-haspopup="true"
            aria-expanded="@_open.ToString().ToLowerInvariant()"
            @onclick="Toggle">
        @if (Trigger == "brand")
        {
            <span>@Brand.Wordmark<em>@Brand.Emphasis</em></span>
            <Glyph Icon="@Icons.Material.Filled.ExpandMore" />
        }
        else
        {
            <Glyph Icon="@Icon" />
        }
    </button>

    @if (_open)
    {
        @* Backdrop closes on any outside press, and swallows the press so it does not
           also land on a window underneath. *@
        <div class="railmenu__backdrop" @onclick="Close"></div>

        @* Always opens downward: these live in the fixed header, so there is no edge to
           open away from any more. *@
        <div class="railmenu__panel railmenu__panel--top @(AlignEnd ? "railmenu__panel--end" : null)"
             role="menu"
             @onkeydown="OnKeyDown"
             tabindex="-1">
            @ChildContent
        </div>
    }
</div>

@code {
    /// <summary>Unused when <see cref="Trigger"/> is "brand", which draws the wordmark instead.</summary>
    [Parameter] public string Icon { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public bool Accent { get; set; }

    /// <summary>"brand" draws the wordmark as the button; anything else draws the icon.</summary>
    [Parameter] public string? Trigger { get; set; }

    /// <summary>Extra classes on the wrapper, so a host can position the menu it owns.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Anchor the panel's right edge to the button — for a menu whose button sits
    /// near the right viewport edge, where a left-anchored panel would overflow off-screen.</summary>
    [Parameter] public bool AlignEnd { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _open;

    private void Toggle() => _open = !_open;

    public void Close() => _open = false;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            Close();
    }
}
