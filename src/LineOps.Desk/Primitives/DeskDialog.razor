@namespace LineOps.Desk.Primitives
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    A floating panel above the desk.

    ADR 0007 kept the desk a strict row of tiled columns and said arbitrary placement is what
    modals and popovers are for. This is that layer, finally built — and deliberately not a
    modal: it does not take the desk hostage. Several can be open at once, each dragged where
    it is useful, because the workflow this serves is comparing things. A modal would force the
    operator to finish with one game before looking at the next, which is the opposite of what
    a board is for.

    It borrows the window's chrome — same title bar height, same controls, same shadow — so it
    reads as a member of the desk rather than a web dialog that wandered in.
*@

<div @ref="_element"
     class="deskdialog @Class"
     style="width:@Width; z-index:@ZIndex"
     role="dialog"
     aria-label="@Title"
     @onmousedown="Raise">

    <div @ref="_handle" class="deskdialog__bar">
        <span class="deskdialog__icon"><Glyph Icon="@Icon" /></span>
        <span class="deskdialog__title">@Title</span>

        @if (Subtitle is not null)
        {
            <span class="deskdialog__sub">@Subtitle</span>
        }

        <span class="deskdialog__spacer"></span>

        <button type="button" class="win__ctl win__ctl--close" title="Close" @onclick="OnClose">
            <Glyph Icon="@Icons.Material.Filled.Close" />
        </button>
    </div>

    <div class="deskdialog__body">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.OpenInNew;
    [Parameter] public string Width { get; set; } = "620px";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnRaise { get; set; }

    /// <summary>Where this dialog sits in the stack. The host owns the ordering.</summary>
    [Parameter] public int ZIndex { get; set; } = 9500;

    /// <summary>How many dialogs were already open, so a new one cascades clear of them.</summary>
    [Parameter] public int Index { get; set; }

    [Parameter] public string? Class { get; set; }

    private ElementReference _element;
    private ElementReference _handle;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DeskDialog>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/LineOps.Desk/js/dialogs.js");
        _self = DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync("cascade", _element, Index);
        await _module.InvokeVoidAsync("attachDrag", _handle, _element, _self);
    }

    /// <summary>
    /// Called once on pointer-up with the resting position. Nothing is stored here yet — the
    /// browser owns the geometry — but the callback exists so a saved layout can be added
    /// without changing the drag path.
    /// </summary>
    [JSInvokable]
    public void OnMoved(double left, double top) { }

    private Task Raise() => OnRaise.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit went first — nothing to release on a browser that is gone.
            }
        }
    }
}
