@namespace LineOps.Desk.Primitives

@*
    TEMPLATE-ABLE — see .claude/skills/apple-mudblazor.

    An alert: the operator must decide before anything else happens.

    This is the narrowest use of modality the system allows, and the only one that is
    allowed to interrupt. Confirmations and destructive gates, nothing else — an alert
    is not a place to show information the operator did not ask about. When the task is
    self-contained but larger than a question, that is DeskSheet; when the operator needs
    to compare things while working, that is DeskDialog and it is not modal at all.

    Two conventions here are load-bearing rather than stylistic. A destructive confirm
    renders red and is never the default, because making the dangerous button answer
    Enter is how people delete things they meant to keep. And labels name the actual
    consequence — "Delete run", not "OK" — because a button that says OK is asking the
    operator to remember what they clicked.

    "Default" used to mean a painted ring and nothing else: the confirm carried a
    box-shadow byte-identical to :focus-visible while focus sat somewhere else entirely
    and Enter activated nothing. A keyboard operator could not tell that ring from a real
    one, which makes it worse than no marking at all. It is now literal — the default
    button is given actual focus on open, so Enter activates it because it is focused, and
    the ring that appears is the browser's own :focus-visible rather than a drawing of one.
    The painted class is gone with the lie. A destructive alert focuses Cancel instead, so
    the rule above holds in the keyboard channel too, not only in the paint.

    The dialog semantics are declared here because there is nowhere else for them: this
    renders bare content, so it inherits neither DeskDialog's explicit role nor MudDialog's.

    Unlike DeskSheet this renders bare content rather than a MudDialog: an alert has no
    title bar, no scroll body and no action tray to fill, so wrapping it in one would only
    buy Mud's title/content/actions padding on top of the padding .desk-alert already
    carries. The surface it lands on is Mud's own .mud-dialog, styled by mud-bridge.css —
    opaque, so the alert needs no material fallback of its own.
*@

<div class="desk-alert"
     role="alertdialog"
     aria-modal="true"
     aria-labelledby="@_headingId"
     aria-describedby="@(Message is null ? null : _messageId)">

    <div class="desk-alert__heading" id="@_headingId">@Heading</div>

    @if (Message is not null)
    {
        <div class="desk-alert__message" id="@_messageId">@Message</div>
    }

    <div class="desk-alert__actions">
        @if (CancelLabel is not null)
        {
            <DeskButton @ref="_cancel"
                        Emphasis="DeskEmphasis.Plain"
                        autofocus="@(CancelIsDefault ? "autofocus" : null)"
                        OnClick="Cancel">
                @CancelLabel
            </DeskButton>
        }

        <DeskButton @ref="_confirm"
                    Emphasis="DeskEmphasis.Filled"
                    Role="@(Destructive ? DeskRole.Destructive : DeskRole.Normal)"
                    autofocus="@(CancelIsDefault ? null : "autofocus")"
                    OnClick="Confirm">
            @ConfirmLabel
        </DeskButton>
    </div>
</div>

@code {
    [CascadingParameter] private IMudDialogInstance? Instance { get; set; }

    [Parameter, EditorRequired] public string Heading { get; set; } = string.Empty;

    /// <summary>The consequence, in a sentence. Omit it when the heading already says everything.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Name the consequence, not the acknowledgement. "Delete run" beats "OK".</summary>
    [Parameter] public string ConfirmLabel { get; set; } = "OK";

    /// <summary>Null for a one-button alert that only needs acknowledging.</summary>
    [Parameter] public string? CancelLabel { get; set; } = "Cancel";

    /// <summary>Renders the confirm red and refuses to make it the default.</summary>
    [Parameter] public bool Destructive { get; set; }

    private DeskButton? _confirm;
    private DeskButton? _cancel;

    // Ids rather than a literal, because two alerts can be stacked and aria-labelledby is
    // resolved document-wide.
    private readonly string _headingId = $"desk-alert-h-{Guid.NewGuid():N}";
    private readonly string _messageId = $"desk-alert-m-{Guid.NewGuid():N}";

    /// <summary>
    /// A destructive alert defaults to the way out. With no cancel to default to, the
    /// confirm takes it back — a one-button acknowledgement has nothing else to focus.
    /// </summary>
    private bool CancelIsDefault => Destructive && CancelLabel is not null;

    /// <summary>
    /// The alert arrives without focus of its own: Mud's dialog traps the tab ring but does
    /// not choose a starting point, and <c>autofocus</c> is not honoured for content the
    /// renderer inserts after load. So the default button is focused here, once, on the
    /// first render — which is what makes Enter answer the alert rather than the page
    /// behind it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var target = CancelIsDefault ? _cancel : _confirm;

        if (target is not null)
            await target.FocusAsync();
    }

    private void Confirm() => Instance?.Close(DialogResult.Ok(true));

    private void Cancel() => Instance?.Close(DialogResult.Ok(false));
}
