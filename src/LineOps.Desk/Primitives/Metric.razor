@namespace LineOps.Desk.Primitives

@*
    One number on the desk.

    The number leads and the label explains it, because an operator scanning a row of these
    is looking for the figure, not for the word. The note underneath is the qualifier that
    stops the figure being read wrong — "of 14 wanted", "none critical".

    State names the state, not the colour: a caller writes DeskState.Negative and the left
    edge picks up the negative rule. Hue alone never carries the meaning here — the label and
    the note say it in words too — so the tile still reads when the colour does not land.
*@

@if (Actionable)
{
    @* A tile that is also the way to the thing it counts. It is a real button, so it is
       reachable by keyboard and announced as pressable rather than as decoration. *@
    <button type="button" class="@Classes" style="@Styles" title="@ActionHint"
            @onclick="OnClick" @attributes="Extra">
        <span class="metric__go" aria-hidden="true">›</span>
        @Body
    </button>
}
else
{
    <div class="@Classes" style="@Styles" @attributes="Extra">
        @Body
    </div>
}

@code {
    /// <summary>What the figure is, in the operator's words. Sits under the number.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>The figure itself, already formatted.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>
    /// The figure when it needs markup rather than a single string — two counts either side
    /// of a slash, say. Takes precedence over <see cref="Value"/>.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The qualifier that keeps the figure from being read wrong. Hidden when empty.</summary>
    [Parameter] public string? Note { get; set; }

    /// <summary>What the figure means for the operator. See <see cref="DeskState"/> — name the state, not the colour.</summary>
    [Parameter] public DeskState State { get; set; } = DeskState.Neutral;

    /// <summary>Sets the figure in the tabular data face, for counts and prices that must line up.</summary>
    [Parameter] public bool Numeric { get; set; }

    /// <summary>
    /// Where the figure leads. Set it and the tile becomes a button that opens whatever the
    /// number is counting.
    ///
    /// <para>
    /// A count that reports a problem without a way to reach it makes the reader hunt for
    /// what the desk already knows. Apple's feedback guidance is to put status next to the
    /// thing it describes and to make the next step obvious; here the status <i>is</i> the
    /// next step.
    /// </para>
    /// </summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>
    /// What pressing the tile does, in words — "Open the Ops window on these alerts". Shown
    /// as the tooltip, because the chevron says there is somewhere to go but not where.
    /// </summary>
    [Parameter] public string? ActionHint { get; set; }

    /// <summary>Extra classes, appended last so a one-off can still win.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline style, for the spacing a single panel needs and no other.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Anything else the call site passes through. A splatted <c>class</c> is dropped and a
    /// splatted <c>style</c> is appended rather than substituted, because Blazor applies the
    /// splat last and either one would otherwise erase the state modifier this tile computed.
    /// Reach those through <see cref="Class"/> and <see cref="Style"/> instead.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private bool Actionable => OnClick.HasDelegate;

    private string Classes => string.Join(' ', Parts().Where(p => p is { Length: > 0 }));

    private string ValueClasses => Numeric ? "metric__value num" : "metric__value";

    private RenderFragment ValueContent => ChildContent ?? (builder => builder.AddContent(0, Value));

    /// <summary>
    /// The tile's contents, held apart from its box so the button and the plain div render
    /// exactly the same thing rather than two copies that drift.
    /// </summary>
    private RenderFragment Body => @<text>
        <div class="@ValueClasses">@ValueContent</div>
        <div class="metric__label">@Label</div>
        @if (Note is { Length: > 0 })
        {
            <div class="metric__note">@Note</div>
        }
    </text>;

    private IEnumerable<string?> Parts()
    {
        yield return "metric";

        yield return State switch
        {
            DeskState.Positive => "metric--good",
            DeskState.Negative => "metric--bad",
            DeskState.Warning => "metric--warn",
            DeskState.Info => "metric--info",
            _ => null
        };

        yield return Actionable ? "metric--action" : null;

        yield return Class;
    }

    private string? Styles => DeskAttributes.MergeStyle(Style, Attributes);

    private IReadOnlyDictionary<string, object>? Extra => DeskAttributes.WithoutClassOrStyle(Attributes);
}
