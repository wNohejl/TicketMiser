<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Recorded provider payloads, copied next to the test assembly so parsing is verified
       against real response shapes without a network call. -->
  <ItemGroup>
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TicketMiser.Core\TicketMiser.Core.csproj" />
    <ProjectReference Include="..\..\src\TicketMiser.Data\TicketMiser.Data.csproj" />
    <ProjectReference Include="..\..\src\TicketMiser.Reliability\TicketMiser.Reliability.csproj" />
    <ProjectReference Include="..\..\src\TicketMiser.Ingestion\TicketMiser.Ingestion.csproj" />
  </ItemGroup>

  <!-- The web host, for the queries the ownership rule guards: OwnershipTests runs the very
       WatchlistQueries and PurchaseQueries the desk and the pages call, against Postgres,
       rather than a copy of them moved somewhere a test can reach. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\TicketMiser.Web\TicketMiser.Web.csproj" />
  </ItemGroup>

</Project>
